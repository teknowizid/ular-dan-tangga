{
  "expo": {
    "name": "Snake & Ladder Game",
    "slug": "snake-ladder-game",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "snakeladder",
    "extra": {
      "eas": {
        "projectId": "a74d96fd-46c9-4058-a39f-6ddb837017e5"
      }
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snakeladder.game"
    },
    "android": {
      "icon": "./assets/game-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/game-icon.png",
        "backgroundColor": "#4CAF50"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.snakeladder.game",
      "statusBarStyle": "light",
      "statusBarBackgroundColor": "#ffffff"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  }
}